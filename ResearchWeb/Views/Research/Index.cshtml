@model IEnumerable<ResearchWeb.Models.Research2026>

@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "الأبحاث العلمية 2026";

    var role = Context.Session.GetString("Role");
    var searchText = Context.Request.Query["search"].ToString();
}

<style>
    /* =========================================================
           ألوان صفوف اللجان
           ========================================================= */
    .committee-row td {
        background-color: var(--committee-color) !important;
        color: #212529;
    }

    /* =========================================================
           وميض الأبحاث غير المقبولة
           ========================================================= */
    .rejected-row td {
        font-weight: bold;
        animation: rejectedBlink 1s infinite ease-in-out;
    }

    @@keyframes rejectedBlink {
        0%, 100% {
            background-color: var(--committee-color);
            color: #212529;
        }

        50% {
            background-color: #ff0000;
            color: #ffffff;
        }
    }

    /* =========================================================
           منع Bootstrap من تغيير ألوان الصفوف
           ========================================================= */
    .research-table tbody tr:nth-of-type(odd) td,
    .research-table tbody tr:nth-of-type(even) td {
        background-color: var(--committee-color);
    }

    .research-table tbody tr.rejected-row td {
        animation: rejectedBlink 1s infinite ease-in-out !important;
    }

    /* =========================================================
           تنسيق الجدول
           ========================================================= */
    .research-table th,
    .research-table td {
        vertical-align: middle;
        text-align: center;
    }

    .research-table td {
        border-color: rgba(0, 0, 0, 0.15);
    }

    .research-table thead th {
        white-space: nowrap;
    }

    /* =========================================================
           تنسيق مجموعة الأزرار
           ========================================================= */
    .research-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 18px;
        align-items: center;
    }

        .research-actions .btn {
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            white-space: nowrap;
        }

    /* =========================================================
           مربع البحث
           ========================================================= */
    .research-search {
        margin-bottom: 18px;
    }

    /* =========================================================
           تحسين العرض على الهاتف
           ========================================================= */
    @@media (max-width: 768px) {
        .research-actions .btn {
            flex: 1 1 45%;
        }

        .research-table {
            font-size: 13px;
        }
    }
</style>

<h2 class="text-center mb-4">
    الأبحاث العلمية 2026
</h2>

<!-- =========================================================
     أزرار العمليات
     ========================================================= -->
<div class="research-actions">

    @if (role == "Admin")
    {
        <a asp-controller="Research"
           asp-action="Create"
           class="btn btn-success">
            ➕ إضافة بحث جديد
        </a>
    }

    <a asp-controller="Research"
       asp-action="Duplicates"
       class="btn btn-danger">
        🔁 فحص الأبحاث المكررة
    </a>

    <a asp-controller="Research"
       asp-action="ByMeeting"
       class="btn btn-info">
        📅 أبحاث حسب رقم اللجنة
    </a>

    <a asp-controller="Research"
       asp-action="Rejected"
       class="btn btn-danger">
        ❌ الأبحاث غير المقبولة
    </a>

    <!-- تصدير نتائج البحث الحالية إلى Excel -->
    <a asp-controller="Research"
       asp-action="ExportExcel"
       asp-route-search="@searchText"
       class="btn btn-success">
        📊 تصدير إلى Excel
    </a>

</div>

<!-- =========================================================
     البحث
     ========================================================= -->
<form asp-controller="Research"
      asp-action="Index"
      method="get"
      class="research-search">

    <div class="input-group">

        <input type="text"
               name="search"
               value="@searchText"
               class="form-control"
               placeholder="ابحث باسم الباحث أو عنوان البحث أو رقم البحث أو الهاتف..." />

        <button class="btn btn-primary"
                type="submit">
            🔍 بحث
        </button>

        <a asp-controller="Research"
           asp-action="Index"
           class="btn btn-secondary">
            ✖ مسح
        </a>

    </div>
</form>

<!-- =========================================================
     عدد الأبحاث
     ========================================================= -->
<div class="alert alert-info text-center">
    عدد الأبحاث:
    <strong>@Model.Count()</strong>
</div>

<!-- =========================================================
     جدول الأبحاث
     ========================================================= -->
<div class="table-responsive">

    <table class="table table-bordered text-center research-table">

        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>اسم الباحث</th>
                <th>تاريخ الاجتماع</th>
                <th>عنوان البحث</th>
                <th>رقم البحث</th>
                <th>رقم اللجنة</th>
                <th>نتيجة البحث</th>
                <th>رقم الهاتف</th>
                <th>توصيات اللجنة</th>

                @if (role == "Admin")
                {
                    <th>إجراءات</th>
                }
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                // قراءة رقم اللجنة
                int meetingNumber = 0;

                int.TryParse(
                item.رقم_الاجتماع?.Trim(),
                out meetingNumber
                );

                // إنشاء لون ثابت ومميز لكل لجنة
                double hue = (meetingNumber * 137.508) % 360;

                string committeeColor =
                $"hsl({hue:F0}, 70%, 88%)";

                // البحث غير المقبول نتيجته 1
                bool isRejected =
                item.نتيجة_البحث?.Trim() == "1";

                string rowClass = isRejected
                ? "rejected-row"
                : "committee-row";

                <tr class="@rowClass"
                    style="--committee-color: @committeeColor;">

                    <td>@item.ID</td>

                    <td>@item.اسم_الباحث</td>

                    <td>
                        @(item.تاريخ_الاجتماع.HasValue
                                            ? item.تاريخ_الاجتماع.Value.ToString("dd/MM/yyyy")
                                            : "")
                </td>

                    <td>@item.عنوان_البحث</td>

                    <td>@item.رقم_البحث</td>

                    <td>@item.رقم_الاجتماع</td>

                    <td>@item.نتيجة_البحث</td>

                    <td>@item.رقم_الهاتف</td>

                    <td>@item.توصيات_اللجنة</td>

                @if (role == "Admin")
                    {
                        <td>
                            <div class="d-flex flex-wrap justify-content-center gap-1">

                                <a asp-controller="Research"
                                   asp-action="Edit"
                                   asp-route-id="@item.ID"
                                   class="btn btn-warning btn-sm">
                                    ✏ تعديل
                                </a>

                                <a asp-controller="Research"
                                   asp-action="Delete"
                                   asp-route-id="@item.ID"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('هل تريد حذف هذا البحث؟');">
                                    🗑 حذف
                                </a>

                            </div>
                        </td>
                    }

                </tr>
            }
        </tbody>

    </table>

</div>
