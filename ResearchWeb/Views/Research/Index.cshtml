@model IEnumerable<ResearchWeb.Models.Research2026>

@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "الأبحاث العلمية 2026";

    var role = Context.Session.GetString("Role");
}

<style>

    /* =========================================================
           الصف العادي
           ========================================================= */

    .committee-row td {
        background-color: var(--committee-color);
        color: #212529;
    }


    /* =========================================================
           الصف غير المقبول
           ========================================================= */

    .rejected-row td {
        font-weight: bold;
        animation-name: rejectedBlink;
        animation-duration: 1s;
        animation-iteration-count: infinite;
        animation-timing-function: ease-in-out;
    }


    /* =========================================================
           الوميض الأحمر
           ========================================================= */

    @@keyframes rejectedBlink {

        0% {
            background-color: var(--committee-color);
            color: #212529;
        }

        50% {
            background-color: #ff0000;
            color: #ffffff;
        }

        100% {
            background-color: var(--committee-color);
            color: #212529;
        }
    }


    /* =========================================================
           منع Bootstrap من تغيير لون الصف
           ========================================================= */

    .research-table tbody tr:nth-of-type(odd) td,
    .research-table tbody tr:nth-of-type(even) td {
        background-color: var(--committee-color);
    }


    /* =========================================================
           السماح للوميض بالتغلب على لون Bootstrap
           ========================================================= */

    .research-table tbody tr.rejected-row td {
        animation-name: rejectedBlink !important;
    }


    /* =========================================================
           الجدول
           ========================================================= */

    .research-table td,
    .research-table th {
        vertical-align: middle;
    }


    /* =========================================================
           الحدود
           ========================================================= */

    .research-table td {
        border-color: rgba(0, 0, 0, 0.15);
    }

</style>


<h2 class="text-center mb-4">
    الأبحاث العلمية 2026
</h2>


@if (role == "Admin")
{
    <a asp-controller="Research"
       asp-action="Create"
       class="btn btn-success mb-3">

        ➕ إضافة بحث جديد

    </a>
}


<a asp-controller="Research"
   asp-action="Duplicates"
   class="btn btn-danger mb-3">

    🔁 فحص الأبحاث المكررة

</a>


<a asp-controller="Research"
   asp-action="ByMeeting"
   class="btn btn-info mb-3">

    📅 أبحاث حسب رقم اللجنة

</a>


<a asp-controller="Research"
   asp-action="Rejected"
   class="btn btn-danger mb-3">

    ❌ الأبحاث غير المقبولة

</a>


<form method="get" class="mb-3">

    <div class="input-group">

        <input type="text"
               name="search"
               value="@Context.Request.Query["search"]"
               class="form-control"
               placeholder="ابحث باسم الباحث أو عنوان البحث أو رقم البحث أو الهاتف..." />

        <button class="btn btn-primary"
                type="submit">

            🔍 بحث

        </button>


        <a asp-action="Index"
           class="btn btn-secondary">

            ✖ مسح

        </a>

    </div>

</form>


<div class="alert alert-info text-center">

    عدد الأبحاث:

    <strong>
        @Model.Count()
    </strong>

</div>


<div class="table-responsive">

    <table class="table table-bordered text-center research-table">

        <thead class="table-dark">

            <tr>

                <th>ID</th>

                <th>اسم الباحث</th>

                <th>تاريخ الاجتماع</th>

                <th>عنوان البحث</th>

                <th>رقم البحث</th>

                <th>رقم اللجنة</th>

                <th>نتيجة البحث</th>

                <th>رقم الهاتف</th>

                <th>توصيات اللجنة</th>

                @if (role == "Admin")
                {
                    <th>إجراءات</th>
                }

            </tr>

        </thead>


        <tbody>

            @foreach (var item in Model)
            {
                /* =====================================================
                رقم اللجنة
                ===================================================== */

                int meetingNumber = 0;

                int.TryParse(
                item.رقم_الاجتماع?.Trim(),
                out meetingNumber
                );


                /* =====================================================
                إنشاء اللون

                كل لجنة لها لون خاص بها.
                ===================================================== */

                double hue =
                (meetingNumber * 137.508) % 360;


                string committeeColor =
                $"hsl({hue:F0}, 70%, 88%)";


                /* =====================================================
                هل البحث غير مقبول؟
                ===================================================== */

                bool isRejected =
                item.نتيجة_البحث?.Trim() == "1";


                /* =====================================================
                تحديد نوع الصف
                ===================================================== */

                string rowClass =
                isRejected
                ? "rejected-row"
                : "committee-row";


                <tr class="@rowClass"
                    style="--committee-color:@committeeColor;">


                    <td>
                        @item.ID
                    </td>


                    <td>
                        @item.اسم_الباحث
                    </td>


                    <td>
                        @(item.تاريخ_الاجتماع.HasValue
                                            ? item.تاريخ_الاجتماع.Value.ToString("dd/MM/yyyy")
                                            : "")
                </td>


                    <td>
                        @item.عنوان_البحث
                    </td>


                    <td>
                        @item.رقم_البحث
                    </td>


                    <td>
                        @item.رقم_الاجتماع
                    </td>


                    <td>
                        @item.نتيجة_البحث
                    </td>


                    <td>
                        @item.رقم_الهاتف
                    </td>


                    <td>
                        @item.توصيات_اللجنة
                    </td>


                @if (role == "Admin")
                    {
                        <td>

                            <a asp-action="Edit"
                               asp-route-id="@item.ID"
                               class="btn btn-warning btn-sm">

                                ✏ تعديل

                            </a>


                            <a asp-action="Delete"
                               asp-route-id="@item.ID"
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('هل تريد حذف هذا البحث؟');">

                                🗑 حذف

                            </a>

                        </td>
                    }


                </tr>
            }

        </tbody>

    </table>

</div>