@{
    ViewData["Title"] = "أعضاء لجنة أخلاقيات البحث العلمي";
}

<div class="container mt-4">

    <h2 class="text-center mb-4">
        👥 أعضاء لجنة أخلاقيات البحث العلمي
    </h2>

    <div class="card shadow">

        <div class="card-header bg-primary text-white text-center">
            <h4>أعضاء اللجنة</h4>
        </div>

        <div class="card-body">

            <table class="table table-bordered table-striped table-hover text-center">

                <thead class="table-dark">
                    <tr>
                        <th width="40%">الصفة</th>
                        <th>الاسم</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>رئيس اللجنة</td>
                        <td>د. عاطف علي نمورة</td>
                    </tr>

                    <tr>
                        <td>مقرر اللجنة</td>
                        <td>السيد محمود صندوقة</td>
                    </tr>

                    <tr>
                        <td>استشاري جراحة عامة</td>
                        <td>د. باسم بدوان</td>
                    </tr>

                    <tr>
                        <td>استشاري مختبرات</td>
                        <td>د. جمانة النحال</td>
                    </tr>

                    <tr>
                        <td>الصيدلانية</td>
                        <td>ديانا عياد</td>
                    </tr>

                    <tr>
                        <td>استشاري أمراض باطنية</td>
                        <td>د. يوسف قديمات</td>
                    </tr>

                    <tr>
                        <td>المساعد للشؤون الطبية والفنية</td>
                        <td>د. مؤيد القضاة</td>
                    </tr>

                    <tr>
                        <td>أخصائي طب الأطفال</td>
                        <td>د. ناصر الدين أبو لحية</td>
                    </tr>

                    <tr>
                        <td>مدير مديرية الجودة</td>
                        <td>د. بشار النسور</td>
                    </tr>

                </tbody>

            </table>

        </div>

    </div>

    <div class="text-center mt-4">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-secondary">

            ⬅ العودة إلى لوحة التحكم

        </a>

    </div>

</div>