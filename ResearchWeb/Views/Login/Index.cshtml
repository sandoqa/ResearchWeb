@{
    ViewData["Title"] = "تسجيل الدخول";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>


    <style>

        body {
            direction: rtl;
            font-family: "Segoe UI", Tahoma, Arial, sans-serif;
            background-color: #f4f6f9;
        }


        .login-container {
            margin-top: 80px;
        }


        .card {
            border-radius: 15px;
            overflow: hidden;
        }


        .card-header {
            padding: 20px;
        }


        .card-header h3 {
            margin: 0;
            font-size: 28px;
            font-weight: bold;
        }


        .card-body {
            padding: 30px;
        }


        label {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 8px;
        }


        input {
            height: 45px;
            font-size: 18px;
            text-align: right;
        }


        button {
            height: 45px;
            font-size: 18px;
            font-weight: bold;
        }


        .alert {
            font-size: 17px;
        }


    </style>

</head>


<body>


    <div class="container login-container">


        <div class="row justify-content-center">


            <div class="col-md-5">


                <div class="card shadow">


                    <div class="card-header bg-primary text-white text-center">


                        <h3>
                            نظام الأبحاث العلمية
                        </h3>


                    </div>



                    <div class="card-body">



                        @if (ViewBag.Error != null)
                        {

                            <div class="alert alert-danger text-center">

                                @ViewBag.Error

                            </div>

                        }



                        <form method="post">



                            <div class="mb-3">


                                <label class="form-label">

                                    اسم المستخدم

                                </label>



                                <input type="text"
                                       name="username"
                                       class="form-control"
                                       autocomplete="username"
                                       required />



                            </div>





                            <div class="mb-3">


                                <label class="form-label">

                                    كلمة المرور

                                </label>



                                <input type="password"
                                       name="password"
                                       class="form-control"
                                       autocomplete="current-password"
                                       required />



                            </div>





                            <button type="submit"
                                    class="btn btn-primary w-100">


                                دخول


                            </button>



                        </form>



                    </div>


                </div>


            </div>


        </div>


    </div>



</body>

</html>