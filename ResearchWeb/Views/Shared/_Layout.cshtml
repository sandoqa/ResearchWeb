<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام إدارة الأبحاث</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/ResearchWeb.styles.css" />

    <style>
        body {
            background: #f5f7fa;
            font-family: Tahoma, Arial, sans-serif;
        }

        .navbar-brand {
            font-weight: bold;
            font-size: 22px;
        }

        .nav-link {
            font-size: 18px;
            font-weight: bold;
        }

        .container {
            max-width: 1400px;
        }

        footer {
            text-align: center;
            padding: 15px;
            margin-top: 30px;
        }

        @@media (max-width:768px) {

            .navbar-brand {
                font-size: 18px;
            }

            .nav-link {
                font-size: 17px;
                padding: 12px;
            }

            h1, h2, h3, h4, h5 {
                font-size: 22px;
            }

            .btn {
                width: 100%;
                margin-bottom: 8px;
            }

            table {
                font-size: 13px;
            }

            .table-responsive {
                overflow-x: auto;
            }
        }
    </style>

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">

        <div class="container-fluid">
            <img src="~/images/logo.jfif"
                 alt="شعار المستشفى"
                 style="width:80px; height:auto; margin-left:15px;" />
            <a class="navbar-brand"
               asp-controller="Dashboard"
               asp-action="Index">

                📚 نظام إدارة الأبحاث

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarMain">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="navbarMain">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Dashboard"
                           asp-action="Index">
                            لوحة التحكم
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Research"
                           asp-action="Index">
                            الأبحاث
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Research"
                           asp-action="ByMeeting">
                            حسب اللجنة
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Research"
                           asp-action="Duplicates">
                            الأبحاث المكررة
                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>


    <div class="container mt-4">

        @RenderBody()

    </div>


    <footer class="border-top text-muted">

        © 2026 نظام إدارة الأبحاث العلمية

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>